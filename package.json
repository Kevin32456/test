{
  "name": "shuai-gou",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --port 4317 --host",
    "build:server": "tsc -p tsconfig.server.build.json",
    "build": "npm run build:server && tsc -p tsconfig.json --noEmit && vite build",
    "assets:characters": "tsx scripts/generate-character-assets.ts",
    "ops:check": "tsx scripts/check-service.ts",
    "start": "tsx server/start.ts",
    "start:prod": "node dist-server/server/start.js",
    "test": "tsx tests/server.test.ts",
    "test:content": "tsx tests/content.test.ts",
    "test:staging": "tsx tests/staging.smoke.ts",
    "test:staging:network": "tsx tests/staging.network.ts",
    "test:staging:replay": "tsx tests/staging.replay.ts",
    "test:staging:stages": "tsx tests/staging.stages.ts",
    "test:staging:stress": "tsx tests/staging.stress.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "desktop:dev": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --win portable"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.21.2",
    "phaser": "^3.87.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "build": {
    "appId": "com.kevin32456.shuaigou",
    "productName": "Shuai Gou",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "dist-server/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Shuai-Gou-${version}-${arch}.${ext}"
    }
  }
}
